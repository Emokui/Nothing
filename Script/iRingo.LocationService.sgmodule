#!name =  iRingo: 📍 LocationService
#!desc = 自定义定位服务内容\n添加国际版功能\n自定义服务版本
#!author = VirgilClyne[https://github.com/VirgilClyne]
#!homepage = https://NSRingo.github.io/guide/GeoServices/location-service
#!icon = https://images.macrumors.com/article-new/2019/07/ios_location_services-250x250.jpg
#!category =  iRingo
#!date = 2025-10-24 08:48:41
#!version = 1.0.1
#!arguments = GeoCountryCode:"US",Dispatcher.Hybrid:true
#!arguments-desc = GeoCountryCode: [地区检测] 地理国家或地区代码\n    ├ AUTO: 🇺🇳自动（跟随地区检测结果）\n    ├ CN: 🇨🇳中国大陆\n    ├ HK: 🇭🇰中国香港\n    ├ TW: 🇹🇼中国台湾\n    ├ SG: 🇸🇬新加坡\n    ├ US: 🇺🇸美国\n    ├ JP: 🇯🇵日本\n    ├ AU: 🇦🇺澳大利亚\n    ├ GB: 🇬🇧英国\n    ├ KR: 🇰🇷韩国\n    ├ CA: 🇨🇦加拿大\n    └ IE: 🇮🇪爱尔兰\n要更改为的地区或国家，此选项影响GPS/Wi-Fi/有线网络下国家和地区检测的结果。\n\nDispatcher.Hybrid: [调度器] 融合数据\n地点数据接口，此选项影响公共指南，兴趣点(POI)与位置信息等功能。(注：使用国际版调度器时，不会进行数据融合）\n

[Rule]
# 📍 Country Code
DOMAIN,gspe1-ssl.ls.apple.com,DIRECT
# 📍 Amap Dispatcher
DOMAIN,dispatcher.is.autonavi.com,DIRECT

[Script]
# 📍 Country Code
📍 LocationService.pep.gcc.response = type=http-response, pattern=^https?:\/\/gspe1-ssl\.ls\.apple\.com\/pep\/gcc, requires-body=1, script-path=https://raw.githubusercontent.com/Emokui/Steins/Gate/Script/JS/iRingo.LocationService.response.bundle.js, argument=GeoCountryCode="{{{GeoCountryCode}}}"&Dispatcher.Hybrid="{{{Dispatcher.Hybrid}}}"&LogLevel="OFF"
# 📍 Dispatcher
📍 LocationService.Dispatcher.request = type=http-request, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Emokui/Steins/Gate/Script/JS/iRingo.LocationService.request.bundle.js, argument=GeoCountryCode="{{{GeoCountryCode}}}"&Dispatcher.Hybrid="{{{Dispatcher.Hybrid}}}"&LogLevel="OFF"
📍 LocationService.Dispatcher.response = type=http-response, pattern=^https?:\/\/dispatcher\.is\.autonavi\.com\/dispatcher, requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/Emokui/Steins/Gate/Script/JS/iRingo.LocationService.response.bundle.js, argument=GeoCountryCode="{{{GeoCountryCode}}}"&Dispatcher.Hybrid="{{{Dispatcher.Hybrid}}}"&LogLevel="OFF"

[MITM]
hostname = %APPEND% gspe1-ssl.ls.apple.com, dispatcher.is.autonavi.com
