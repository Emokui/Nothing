#!name= 1Blocker
#!desc= unlock pro

[Script]

UnlockVip = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Emokui/Nothing/Zero/Script/1Blocker.js, requires-body=true, max-size=-1, timeout=60
DeleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Emokui/Nothing/Zero/Script/deleteheader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
