#!name= 𝟭𝗕𝗹𝗼𝗰𝗸𝗲𝗿
#!desc= 𝗨𝗻𝗹𝗼𝗰𝗸 𝗣𝗿𝗲𝗺𝗶𝘂𝗺

[Script]

𝗨𝗻𝗹𝗼𝗰𝗸 = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Emokui/Nothing/Zero/Script/JS/1Blocker.js, requires-body=true, max-size=-1, timeout=60
𝗛𝗲𝗮𝗱𝗲𝗿 = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Emokui/Nothing/Zero/Script/JS/DelHeader.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
