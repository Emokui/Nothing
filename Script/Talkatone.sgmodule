#!name= 𝗧𝗮𝗹𝗸𝗮𝘁𝗼𝗻𝗲
#!desc= 𝗥𝗲𝗺𝗼𝘃𝗲 𝗔𝗱 𝗔𝗻𝗱 𝗗𝗜𝗥𝗘𝗖𝗧 𝗖𝗼𝗻𝗻𝗲𝗰𝘁𝗶𝗼𝗻
#!arguments= PROXY:PROXY,DIRECT:DIRECT
#!arguments-desc= Customize PROXY or DIRECT
[Script]
𝗔𝗱𝗕𝗹𝗼𝗰𝗸 = type=http-response, pattern=^https:\/\/.*\/ads\/(topbanner|middlebanner|bottombanner), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/Emokui/Nothing/Zero/Script/JS/Talkatone.js
[Rule]
DOMAIN,googleads.g.doubleclick.net,DIRECT-DROP
DOMAIN,wv.inner-active.mobi,DIRECT-DROP
DOMAIN,ads.pubmatic.com,DIRECT-DROP
DOMAIN,app-analytics-services.com,DIRECT-DROP
DOMAIN,firebaselogging-pa.googleapis.com,DIRECT-DROP
DOMAIN,firebase-settings.crashlytics.com,DIRECT-DROP
DOMAIN,skadnetworks.fyber.com,DIRECT-DROP
DOMAIN-SUFFIX,inmobi.com,DIRECT-DROP
DOMAIN-SUFFIX,spadsync.com,DIRECT-DROP
DOMAIN-SUFFIX,tappx.com,DIRECT-DROP
DOMAIN-SUFFIX,criteo.com,DIRECT-DROP
DOMAIN-SUFFIX,pubmatic.com,DIRECT-DROP
DOMAIN-SUFFIX,smaato.net,DIRECT-DROP
DOMAIN-SUFFIX,amazon-adsystem.com,DIRECT-DROP
DOMAIN-SUFFIX,adsappier.com,DIRECT-DROP
DOMAIN-SUFFIX,appier.net,DIRECT-DROP
DOMAIN-SUFFIX,appiersig.com,DIRECT-DROP
DOMAIN-SUFFIX,sp.mobidriven.com,DIRECT-DROP
DOMAIN-SUFFIX,dsp.appifun.com,DIRECT-DROP
DOMAIN-SUFFIX,telemetry.sdk.inmobi.cn,DIRECT-DROP
DOMAIN-SUFFIX,ads.talkatone.com,DIRECT-DROP
DOMAIN-SUFFIX,analytics.talkatone.com,DIRECT-DROP
DOMAIN-SUFFIX,track.talkatone.com,DIRECT-DROP
DOMAIN-SUFFIX,adserver.talkatone.com,DIRECT-DROP
DOMAIN-SUFFIX,doubleclick.net,DIRECT-DROP
DOMAIN-SUFFIX,googlesyndication.com,DIRECT-DROP
DOMAIN-SUFFIX,inner-active.mobi,DIRECT-DROP
DOMAIN-SUFFIX,mobilefuse.com,DIRECT-DROP
DOMAIN-SUFFIX,tktn.be,{{{PROXY}}}
DOMAIN-SUFFIX,talkatone.com,{{{DIRECT}}}
IP-CIDR,205.164.56.0/24,{{{DIRECT}}},no-resolve
IP-CIDR,50.117.27.0/24,{{{DIRECT}}},no-resolve
IP-CIDR,69.46.75.0/24,{{{DIRECT}}},no-resolve
[MITM]
hostname = %APPEND% *.talkatone.com
